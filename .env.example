# Copy to .env.local and fill in. .env*.local is gitignored — never commit real values.

# Supabase project (the anon/publishable key is safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
NEXT_PUBLIC_BUCKET=pics

# OpenAI (server-only — NEVER prefix with NEXT_PUBLIC)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-2

# One-time DB setup only (scripts/setup-supabase.mjs). Server/admin credential —
# keep out of git, prefer running the SQL in the Supabase dashboard instead.
# SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.<your-ref>.supabase.co:5432/postgres

# Optional: restrict the AI edit endpoint to requests from your own deploy.
# Comma-separated list of allowed Origins. If unset, only same-origin is allowed.
# ALLOWED_EDIT_ORIGINS=https://picmove.vercel.app
